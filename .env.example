# Copy to apps/web/.env and adjust. Never commit real secrets (CLAUDE.md §7).

# Postgres (infra/docker-compose.yml)
DATABASE_URL=postgres://dernekhub:dernekhub@localhost:5432/dernekhub

# Payload: at least 32 random characters, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=replace-with-at-least-32-random-characters

# Tenants resolve as <slug>.<ROOT_DOMAIN>
ROOT_DOMAIN=dernekhub.localhost

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
