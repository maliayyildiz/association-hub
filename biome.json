{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/payload-types.ts",
      "!**/importMap.js",
      "!**/migrations",
      "!**/next-env.d.ts",
      "!**/pnpm-lock.yaml",
      "!**/*.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error"
      },
      "style": {
        "noNonNullAssertion": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/src/app/_sites/**", "apps/web/src/components/site/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "payload": "Public site code must read data via modules/*/queries.ts (CLAUDE.md §3.2).",
                  "@payload-config": "Public site code must read data via modules/*/queries.ts (CLAUDE.md §3.2)."
                }
              }
            }
          }
        }
      }
    }
  ]
}
